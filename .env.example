# ==========================================
# RAPOR SMK (KURIKULUM MERDEKA) - ENVIRONMENT CONFIG
# ==========================================

# Application Environment (development / production)
APP_ENV=development
APP_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=rapor_smk
DB_SSLMODE=disable

# Redis Cache Configuration
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JSON Web Token (JWT) Security
JWT_SECRET=rapor-smk-super-secret-jwt-key-2026-development
JWT_EXPIRATION_HOURS=24

# Dapodik Web Service Defaults (Optional: can be configured via Web UI /settings/dapodik)
DAPODIK_HOST=localhost
DAPODIK_PORT=5774
DAPODIK_TOKEN=
DAPODIK_NPSN=20108921
DAPODIK_TIMEOUT=15
